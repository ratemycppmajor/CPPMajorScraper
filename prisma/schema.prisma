generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model College {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  collegeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  majors    Major[]

  @@unique([name, collegeId])
}

model Major {
  id           String     @id @default(cuid())
  name         String
  imgSrc       String?
  url          String?
  description  String?
  departmentId String
  averageGpa   Float?
  slug         String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviews      Review[]

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  @@unique([name, departmentId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  userId    String
  majorId   String
  major     Major    @relation(fields: [majorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime? @map("email_verified")
  studentVerified Boolean   @default(false) @map("student_verified")
  image           String?
  password        String?
  reviews         Review[]

  @@map("users")
}
